  "total_target": 1000,
  "batches": [
    {
      "id": "core",
      "name": "光之启程",
      "description": "小学 1~3 年级课内必背古诗，主线前半段优先题库",
      "target_count": 300
    },
    {
      "id": "expand",
      "name": "星河诗卷",
      "description": "小学 4~6 年级古诗，中后期星球逐步解锁",
      "target_count": 700
    }
  ],
  "poems": [
    {
      "id": 1,
      "title": "咏鹅",
      "author": "骆宾王",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["动物", "池塘"],
      "lines": ["鹅，鹅，鹅，", "曲项向天歌。", "白毛浮绿水，", "红掌拨清波。"]
    },
    {
      "id": 2,
      "title": "静夜思",
      "author": "李白",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["月亮", "思乡"],
      "lines": ["床前明月光，", "疑是地上霜。", "举头望明月，", "低头思故乡。"]
    },
    {
      "id": 3,
      "title": "画",
      "author": "王维",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["山水", "画面"],
      "lines": ["远看山有色，", "近听水无声。", "春去花还在，", "人来鸟不惊。"]
    },
    {
      "id": 4,
      "title": "悯农（其二）",
      "author": "李绅",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["劳动", "珍惜"],
      "lines": ["锄禾日当午，", "汗滴禾下土。", "谁知盘中餐，", "粒粒皆辛苦。"]
    },
    {
      "id": 5,
      "title": "古朗月行（节选）",
      "author": "李白",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["月亮", "想象"],
      "lines": ["小时不识月，", "呼作白玉盘。", "又疑瑶台镜，", "飞在青云端。"]
    },
    {
      "id": 6,
      "title": "寻隐者不遇",
      "author": "贾岛",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["山", "问答"],
      "lines": ["松下问童子，", "言师采药去。", "只在此山中，", "云深不知处。"]
    },
    {
      "id": 7,
      "title": "春晓",
      "author": "孟浩然",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["春天", "花鸟"],
      "lines": ["春眠不觉晓，", "处处闻啼鸟。", "夜来风雨声，", "花落知多少。"]
    },
    {
      "id": 8,
      "title": "村居",
      "author": "高鼎",
      "dynasty": "清",
      "grade": 1,
      "batch": "core",
      "tags": ["春天", "儿童"],
      "lines": ["草长莺飞二月天，", "拂堤杨柳醉春烟。", "儿童散学归来早，", "忙趁东风放纸鸢。"]
    },
    {
      "id": 9,
      "title": "咏柳",
      "author": "贺知章",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["春天", "柳树"],
      "lines": ["碧玉妆成一树高，", "万条垂下绿丝绦。", "不知细叶谁裁出，", "二月春风似剪刀。"]
    },
    {
      "id": 10,
      "title": "小池",
      "author": "杨万里",
      "dynasty": "宋",
      "grade": 1,
      "batch": "core",
      "tags": ["夏天", "荷花"],
      "lines": ["泉眼无声惜细流，", "树阴照水爱晴柔。", "小荷才露尖尖角，", "早有蜻蜓立上头。"]
    },
    {
      "id": 11,
      "title": "所见",
      "author": "袁枚",
      "dynasty": "清",
      "grade": 1,
      "batch": "core",
      "tags": ["儿童", "牧童"],
      "lines": ["牧童骑黄牛，", "歌声振林樾。", "意欲捕鸣蝉，", "忽然闭口立。"]
    },
    {
      "id": 12,
      "title": "小儿垂钓",
      "author": "胡令能",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["儿童", "钓鱼"],
      "lines": ["蓬头稚子学垂纶，", "侧坐莓苔草映身。", "路人借问遥招手，", "怕得鱼惊不应人。"]
    },
    {
      "id": 13,
      "title": "赠汪伦",
      "author": "李白",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["友情", "送别"],
      "lines": ["李白乘舟将欲行，", "忽闻岸上踏歌声。", "桃花潭水深千尺，", "不及汪伦送我情。"]
    },
    {
      "id": 14,
      "title": "望庐山瀑布",
      "author": "李白",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["山水", "瀑布"],
      "lines": ["日照香炉生紫烟，", "遥看瀑布挂前川。", "飞流直下三千尺，", "疑是银河落九天。"]
    },
    {
      "id": 15,
      "title": "绝句",
      "author": "杜甫",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["春天", "鸟"],
      "lines": ["两个黄鹂鸣翠柳，", "一行白鹭上青天。", "窗含西岭千秋雪，", "门泊东吴万里船。"]
    },
    {
      "id": 16,
      "title": "登鹳雀楼",
      "author": "王之涣",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["登高", "黄河"],
      "lines": ["白日依山尽，", "黄河入海流。", "欲穷千里目，", "更上一层楼。"]
    },
    {
      "id": 17,
      "title": "梅花",
      "author": "王安石",
      "dynasty": "宋",
      "grade": 1,
      "batch": "core",
      "tags": ["冬天", "梅花"],
      "lines": ["墙角数枝梅，", "凌寒独自开。", "遥知不是雪，", "为有暗香来。"]
    },
    {
      "id": 18,
      "title": "夜宿山寺",
      "author": "李白",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["山", "想象"],
      "lines": ["危楼高百尺，", "手可摘星辰。", "不敢高声语，", "恐惊天上人。"]
    },
    {
      "id": 19,
      "title": "敕勒歌",
      "author": "北朝民歌",
      "dynasty": "南北朝",
      "grade": 1,
      "batch": "core",
      "tags": ["草原", "牛羊"],
      "lines": ["敕勒川，阴山下。", "天似穹庐，笼盖四野。", "天苍苍，野茫茫，", "风吹草低见牛羊。"]
    },
    {
      "id": 20,
      "title": "江雪",
      "author": "柳宗元",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["冬天", "雪"],
      "lines": ["千山鸟飞绝，", "万径人踪灭。", "孤舟蓑笠翁，", "独钓寒江雪。"]
    },
    {
      "id": 21,
      "title": "池上",
      "author": "白居易",
      "dynasty": "唐",
      "grade": 1,
      "batch": "core",
      "tags": ["夏天", "儿童"],
      "lines": ["小娃撑小艇，", "偷采白莲回。", "不解藏踪迹，", "浮萍一道开。"]
    },
    {
      "id": 22,
      "title": "赠刘景文",
      "author": "苏轼",
      "dynasty": "宋",
      "grade": 2,
      "batch": "core",
      "tags": ["秋天", "菊花"],
      "lines": ["荷尽已无擎雨盖，", "菊残犹有傲霜枝。", "一年好景君须记，", "最是橙黄橘绿时。"]
    },
    {
      "id": 23,
      "title": "山行",
      "author": "杜牧",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["秋天", "枫叶"],
      "lines": ["远上寒山石径斜，", "白云生处有人家。", "停车坐爱枫林晚，", "霜叶红于二月花。"]
    },
    {
      "id": 24,
      "title": "回乡偶书",
      "author": "贺知章",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["故乡", "儿童"],
      "lines": ["少小离家老大回，", "乡音无改鬓毛衰。", "儿童相见不相识，", "笑问客从何处来。"]
    },
    {
      "id": 25,
      "title": "望天门山",
      "author": "李白",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["山水", "长江"],
      "lines": ["天门中断楚江开，", "碧水东流至此回。", "两岸青山相对出，", "孤帆一片日边来。"]
    },
    {
      "id": 26,
      "title": "饮湖上初晴后雨",
      "author": "苏轼",
      "dynasty": "宋",
      "grade": 2,
      "batch": "core",
      "tags": ["西湖", "雨"],
      "lines": ["水光潋滟晴方好，", "山色空蒙雨亦奇。", "欲把西湖比西子，", "淡妆浓抹总相宜。"]
    },
    {
      "id": 27,
      "title": "元日",
      "author": "王安石",
      "dynasty": "宋",
      "grade": 2,
      "batch": "core",
      "tags": ["春节", "风俗"],
      "lines": ["爆竹声中一岁除，", "春风送暖入屠苏。", "千门万户曈曈日，", "总把新桃换旧符。"]
    },
    {
      "id": 28,
      "title": "清明",
      "author": "杜牧",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["清明", "雨"],
      "lines": ["清明时节雨纷纷，", "路上行人欲断魂。", "借问酒家何处有，", "牧童遥指杏花村。"]
    },
    {
      "id": 29,
      "title": "九月九日忆山东兄弟",
      "author": "王维",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["重阳", "思亲"],
      "lines": ["独在异乡为异客，", "每逢佳节倍思亲。", "遥知兄弟登高处，", "遍插茱萸少一人。"]
    },
    {
      "id": 30,
      "title": "早发白帝城",
      "author": "李白",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["长江", "行舟"],
      "lines": ["朝辞白帝彩云间，", "千里江陵一日还。", "两岸猿声啼不住，", "轻舟已过万重山。"]
    },
    {
      "id": 31,
      "title": "绝句",
      "author": "杜甫",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["春天", "燕子"],
      "lines": ["迟日江山丽，", "春风花草香。", "泥融飞燕子，", "沙暖睡鸳鸯。"]
    },
    {
      "id": 32,
      "title": "三衢道中",
      "author": "曾几",
      "dynasty": "宋",
      "grade": 2,
      "batch": "core",
      "tags": ["夏天", "山路"],
      "lines": ["梅子黄时日日晴，", "小溪泛尽却山行。", "绿阴不减来时路，", "添得黄鹂四五声。"]
    },
    {
      "id": 33,
      "title": "忆江南",
      "author": "白居易",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["江南", "春天"],
      "lines": ["江南好，", "风景旧曾谙。", "日出江花红胜火，", "春来江水绿如蓝。", "能不忆江南？"]
    },
    {
      "id": 34,
      "title": "泊船瓜洲",
      "author": "王安石",
      "dynasty": "宋",
      "grade": 2,
      "batch": "core",
      "tags": ["春天", "思乡"],
      "lines": ["京口瓜洲一水间，", "钟山只隔数重山。", "春风又绿江南岸，", "明月何时照我还。"]
    },
    {
      "id": 35,
      "title": "游园不值",
      "author": "叶绍翁",
      "dynasty": "宋",
      "grade": 2,
      "batch": "core",
      "tags": ["春天", "杏花"],
      "lines": ["应怜屐齿印苍苔，", "小扣柴扉久不开。", "春色满园关不住，", "一枝红杏出墙来。"]
    },
    {
      "id": 36,
      "title": "春日",
      "author": "朱熹",
      "dynasty": "宋",
      "grade": 2,
      "batch": "core",
      "tags": ["春天", "花"],
      "lines": ["胜日寻芳泗水滨，", "无边光景一时新。", "等闲识得东风面，", "万紫千红总是春。"]
    },
    {
      "id": 37,
      "title": "乞巧",
      "author": "林杰",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["七夕", "传说"],
      "lines": ["七夕今宵看碧霄，", "牵牛织女渡河桥。", "家家乞巧望秋月，", "穿尽红丝几万条。"]
    },
    {
      "id": 38,
      "title": "晓出净慈寺送林子方",
      "author": "杨万里",
      "dynasty": "宋",
      "grade": 2,
      "batch": "core",
      "tags": ["夏天", "荷花"],
      "lines": ["毕竟西湖六月中，", "风光不与四时同。", "接天莲叶无穷碧，", "映日荷花别样红。"]
    },
    {
      "id": 39,
      "title": "赋得古原草送别（节选）",
      "author": "白居易",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["草", "送别"],
      "lines": ["离离原上草，", "一岁一枯荣。", "野火烧不尽，", "春风吹又生。"]
    },
    {
      "id": 40,
      "title": "鹿柴",
      "author": "王维",
      "dynasty": "唐",
      "grade": 2,
      "batch": "core",
      "tags": ["山", "幽静"],
      "lines": ["空山不见人，", "但闻人语响。", "返景入深林，", "复照青苔上。"]
    },
    {
      "id": 41,
      "title": "送元二使安西",
      "author": "王维",
      "dynasty": "唐",
      "grade": 3,
      "batch": "core",
      "tags": ["送别", "柳"],
      "lines": ["渭城朝雨浥轻尘，", "客舍青青柳色新。", "劝君更尽一杯酒，", "西出阳关无故人。"]
    },
    {
      "id": 42,
      "title": "黄鹤楼送孟浩然之广陵",
      "author": "李白",
      "dynasty": "唐",
      "grade": 3,
      "batch": "core",
      "tags": ["送别", "长江"],
      "lines": ["故人西辞黄鹤楼，", "烟花三月下扬州。", "孤帆远影碧空尽，", "唯见长江天际流。"]
    },
    {
      "id": 43,
      "title": "独坐敬亭山",
      "author": "李白",
      "dynasty": "唐",
      "grade": 3,
      "batch": "core",
      "tags": ["山", "孤独"],
      "lines": ["众鸟高飞尽，", "孤云独去闲。", "相看两不厌，", "只有敬亭山。"]
    },
    {
      "id": 44,
      "title": "望洞庭",
      "author": "刘禹锡",
      "dynasty": "唐",
      "grade": 3,
      "batch": "core",
      "tags": ["秋天", "洞庭湖"],
      "lines": ["湖光秋月两相和，", "潭面无风镜未磨。", "遥望洞庭山水翠，", "白银盘里一青螺。"]
    },
    {
      "id": 45,
      "title": "浪淘沙（其一）",
      "author": "刘禹锡",
      "dynasty": "唐",
      "grade": 3,
      "batch": "core",
      "tags": ["黄河", "想象"],
      "lines": ["九曲黄河万里沙，", "浪淘风簸自天涯。", "如今直上银河去，", "同到牵牛织女家。"]
    },
    {
      "id": 46,
      "title": "江南春",
      "author": "杜牧",
      "dynasty": "唐",
      "grade": 3,
      "batch": "core",
      "tags": ["春天", "江南"],
      "lines": ["千里莺啼绿映红，", "水村山郭酒旗风。", "南朝四百八十寺，", "多少楼台烟雨中。"]
    },
    {
      "id": 47,
      "title": "江上渔者",
      "author": "范仲淹",
      "dynasty": "宋",
      "grade": 3,
      "batch": "core",
      "tags": ["江", "劳动"],
      "lines": ["江上往来人，", "但爱鲈鱼美。", "君看一叶舟，", "出没风波里。"]
    },
    {
      "id": 48,
      "title": "题西林壁",
      "author": "苏轼",
      "dynasty": "宋",
      "grade": 3,
      "batch": "core",
      "tags": ["庐山", "哲理"],
      "lines": ["横看成岭侧成峰，", "远近高低各不同。", "不识庐山真面目，", "只缘身在此山中。"]
    },
    {
      "id": 49,
      "title": "枫桥夜泊",
      "author": "张继",
      "dynasty": "唐",
      "grade": 3,
      "batch": "core",
      "tags": ["秋天", "夜晚"],
      "lines": ["月落乌啼霜满天，", "江枫渔火对愁眠。", "姑苏城外寒山寺，", "夜半钟声到客船。"]
    },
    {
      "id": 50,
      "title": "渔歌子",
      "author": "张志和",
      "dynasty": "唐",
      "grade": 3,
      "batch": "core",
      "tags": ["春天", "钓鱼"],
      "lines": ["西塞山前白鹭飞，", "桃花流水鳜鱼肥。", "青箬笠，绿蓑衣，", "斜风细雨不须归。"]
    },
    {
      "id": 51,
      "title": "塞下曲",
      "author": "卢纶",
      "dynasty": "唐",
      "grade": 3,
      "batch": "core",
      "tags": ["边塞", "雪"],
      "lines": ["月黑雁飞高，", "单于夜遁逃。", "欲将轻骑逐，", "大雪满弓刀。"]
    },
    {
      "id": 52,
      "title": "墨梅",
      "author": "王冕",
      "dynasty": "元",
      "grade": 3,
      "batch": "core",
      "tags": ["梅花", "品格"],
      "lines": ["我家洗砚池头树，", "朵朵花开淡墨痕。", "不要人夸好颜色，", "只留清气满乾坤。"]
    },
    {
      "id": 53,
      "title": "石灰吟",
      "author": "于谦",
      "dynasty": "明",
      "grade": 3,
      "batch": "core",
      "tags": ["品格", "石灰"],
      "lines": ["千锤万凿出深山，", "烈火焚烧若等闲。", "粉骨碎身浑不怕，", "要留清白在人间。"]
    },
    {
      "id": 54,
      "title": "竹石",
      "author": "郑燮",
      "dynasty": "清",
      "grade": 3,
      "batch": "core",
      "tags": ["竹子", "品格"],
      "lines": ["咬定青山不放松，", "立根原在破岩中。", "千磨万击还坚劲，", "任尔东西南北风。"]
    },
    {
      "id": 55,
      "title": "马诗",
      "author": "李贺",
      "dynasty": "唐",
      "grade": 3,
      "batch": "core",
      "tags": ["马", "边塞"],
      "lines": ["大漠沙如雪，", "燕山月似钩。", "何当金络脑，", "快走踏清秋。"]
    },
    {
      "id": 56,
      "title": "鸟鸣涧",
      "author": "王维",
      "dynasty": "唐",
      "grade": 4,
      "batch": "expand",
      "tags": ["春天", "山"],
      "lines": ["人闲桂花落，", "夜静春山空。", "月出惊山鸟，", "时鸣春涧中。"]
    },
    {
      "id": 57,
      "title": "闻王昌龄左迁龙标遥有此寄",
      "author": "李白",
      "dynasty": "唐",
      "grade": 4,
      "batch": "expand",
      "tags": ["友情", "月亮"],
      "lines": ["杨花落尽子规啼，", "闻道龙标过五溪。", "我寄愁心与明月，", "随君直到夜郎西。"]
    },
    {
      "id": 58,
      "title": "江畔独步寻花",
      "author": "杜甫",
      "dynasty": "唐",
      "grade": 4,
      "batch": "expand",
      "tags": ["春天", "花"],
      "lines": ["黄四娘家花满蹊，", "千朵万朵压枝低。", "留连戏蝶时时舞，", "自在娇莺恰恰啼。"]
    },
    {
      "id": 59,
      "title": "早春呈水部张十八员外",
      "author": "韩愈",
      "dynasty": "唐",
      "grade": 4,
      "batch": "expand",
      "tags": ["春天", "小雨"],
      "lines": ["天街小雨润如酥，", "草色遥看近却无。", "最是一年春好处，", "绝胜烟柳满皇都。"]
    },
    {
      "id": 60,
      "title": "四时田园杂兴（其三十一）",
      "author": "范成大",
      "dynasty": "宋",
      "grade": 4,
      "batch": "expand",
      "tags": ["田园", "劳动"],
      "lines": ["昼出耘田夜绩麻，", "村庄儿女各当家。", "童孙未解供耕织，", "也傍桑阴学种瓜。"]
    },
    {
      "id": 61,
      "title": "宿新市徐公店",
      "author": "杨万里",
      "dynasty": "宋",
      "grade": 4,
      "batch": "expand",
      "tags": ["春天", "儿童"],
      "lines": ["篱落疏疏一径深，", "树头新绿未成阴。", "儿童急走追黄蝶，", "飞入菜花无处寻。"]
    },
    {
      "id": 62,
      "title": "夏日绝句",
      "author": "李清照",
      "dynasty": "宋",
      "grade": 4,
      "batch": "expand",
      "tags": ["英雄", "项羽"],
      "lines": ["生当作人杰，", "死亦为鬼雄。", "至今思项羽，", "不肯过江东。"]
    },
    {
      "id": 63,
      "title": "芙蓉楼送辛渐",
      "author": "王昌龄",
      "dynasty": "唐",
      "grade": 4,
      "batch": "expand",
      "tags": ["送别", "雨"],
      "lines": ["寒雨连江夜入吴，", "平明送客楚山孤。", "洛阳亲友如相问，", "一片冰心在玉壶。"]
    },
    {
      "id": 64,
      "title": "凉州词",
      "author": "王之涣",
      "dynasty": "唐",
      "grade": 4,
      "batch": "expand",
      "tags": ["边塞", "黄河"],
      "lines": ["黄河远上白云间，", "一片孤城万仞山。", "羌笛何须怨杨柳，", "春风不度玉门关。"]
    },
    {
      "id": 65,
      "title": "出塞",
      "author": "王昌龄",
      "dynasty": "唐",
      "grade": 4,
      "batch": "expand",
      "tags": ["边塞", "月亮"],
      "lines": ["秦时明月汉时关，", "万里长征人未还。", "但使龙城飞将在，", "不教胡马度阴山。"]
    },
    {
      "id": 66,
      "title": "凉州词",
      "author": "王翰",
      "dynasty": "唐",
      "grade": 4,
      "batch": "expand",
      "tags": ["边塞", "将士"],
      "lines": ["葡萄美酒夜光杯，", "欲饮琵琶马上催。", "醉卧沙场君莫笑，", "古来征战几人回？"]
    },
    {
      "id": 67,
      "title": "过故人庄",
      "author": "孟浩然",
      "dynasty": "唐",
      "grade": 4,
      "batch": "expand",
      "tags": ["田园", "友情"],
      "lines": ["故人具鸡黍，", "邀我至田家。", "绿树村边合，", "青山郭外斜。", "开轩面场圃，", "把酒话桑麻。", "待到重阳日，", "还来就菊花。"]
    },
    {
      "id": 68,
      "title": "游子吟",
      "author": "孟郊",
      "dynasty": "唐",
      "grade": 5,
      "batch": "expand",
      "tags": ["母爱", "亲情"],
      "lines": ["慈母手中线，", "游子身上衣。", "临行密密缝，", "意恐迟迟归。", "谁言寸草心，", "报得三春晖。"]
    },
    {
      "id": 69,
      "title": "示儿",
      "author": "陆游",
      "dynasty": "宋",
      "grade": 5,
      "batch": "expand",
      "tags": ["家国", "爱国"],
      "lines": ["死去元知万事空，", "但悲不见九州同。", "王师北定中原日，", "家祭无忘告乃翁。"]
    },
    {
      "id": 70,
      "title": "题临安邸",
      "author": "林升",
      "dynasty": "宋",
      "grade": 5,
      "batch": "expand",
      "tags": ["西湖", "家国"],
      "lines": ["山外青山楼外楼，", "西湖歌舞几时休？", "暖风熏得游人醉，", "直把杭州作汴州。"]
    },
    {
      "id": 71,
      "title": "己亥杂诗",
      "author": "龚自珍",
      "dynasty": "清",
      "grade": 5,
      "batch": "expand",
      "tags": ["家国", "人才"],
      "lines": ["九州生气恃风雷，", "万马齐喑究可哀。", "我劝天公重抖擞，", "不拘一格降人才。"]
    },
    {
      "id": 72,
      "title": "秋夜将晓出篱门迎凉有感",
      "author": "陆游",
      "dynasty": "宋",
      "grade": 5,
      "batch": "expand",
      "tags": ["家国", "黄河"],
      "lines": ["三万里河东入海，", "五千仞岳上摩天。", "遗民泪尽胡尘里，", "南望王师又一年。"]
    },
    {
      "id": 73,
      "title": "清平乐·村居",
      "author": "辛弃疾",
      "dynasty": "宋",
      "grade": 5,
      "batch": "expand",
      "tags": ["田园", "儿童"],
      "lines": ["茅檐低小，", "溪上青青草。", "醉里吴音相媚好，", "白发谁家翁媪？", "大儿锄豆溪东，", "中儿正织鸡笼。", "最喜小儿亡赖，", "溪头卧剥莲蓬。"]
    },
    {
      "id": 74,
      "title": "稚子弄冰",
      "author": "杨万里",
      "dynasty": "宋",
      "grade": 5,
      "batch": "expand",
      "tags": ["冬天", "儿童"],
      "lines": ["稚子金盆脱晓冰，", "彩丝穿取当银钲。", "敲成玉磬穿林响，", "忽作玻璃碎地声。"]
    },
    {
      "id": 75,
      "title": "村晚",
      "author": "雷震",
      "dynasty": "宋",
      "grade": 5,
      "batch": "expand",
      "tags": ["田园", "牧童"],
      "lines": ["草满池塘水满陂，", "山衔落日浸寒漪。", "牧童归去横牛背，", "短笛无腔信口吹。"]
    },
    {
      "id": 76,
      "title": "春夜喜雨",
      "author": "杜甫",
      "dynasty": "唐",
      "grade": 6,
      "batch": "expand",
      "tags": ["春天", "雨"],
      "lines": ["好雨知时节，", "当春乃发生。", "随风潜入夜，", "润物细无声。", "野径云俱黑，", "江船火独明。", "晓看红湿处，", "花重锦官城。"]
    },
    {
      "id": 77,
      "title": "望岳",
      "author": "杜甫",
      "dynasty": "唐",
      "grade": 6,
      "batch": "expand",
      "tags": ["泰山", "登高"],
      "lines": ["岱宗夫如何？", "齐鲁青未了。", "造化钟神秀，", "阴阳割昏晓。", "荡胸生曾云，", "决眦入归鸟。", "会当凌绝顶，", "一览众山小。"]
    },
    {
      "id": 78,
      "title": "游山西村",
      "author": "陆游",
      "dynasty": "宋",
      "grade": 6,
      "batch": "expand",
      "tags": ["田园", "山路"],
      "lines": ["莫笑农家腊酒浑，", "丰年留客足鸡豚。", "山重水复疑无路，", "柳暗花明又一村。", "箫鼓追随春社近，", "衣冠简朴古风存。", "从今若许闲乘月，", "拄杖无时夜叩门。"]
    },
    {
      "id": 79,
      "title": "长歌行",
      "author": "汉乐府",
      "dynasty": "汉",
      "grade": 6,
      "batch": "expand",
      "tags": ["惜时", "劝学"],
      "lines": ["青青园中葵，", "朝露待日晞。", "阳春布德泽，", "万物生光辉。", "常恐秋节至，", "焜黄华叶衰。", "百川东到海，", "何时复西归？", "少壮不努力，", "老大徒伤悲。"]
    },
    {
      "id": 80,
      "title": "七步诗",
      "author": "曹植",
      "dynasty": "三国",
      "grade": 6,
      "batch": "expand",
      "tags": ["亲情", "比喻"],
      "lines": ["煮豆持作羹，", "漉菽以为汁。", "萁在釜下燃，", "豆在釜中泣。", "本自同根生，", "相煎何太急？"]
    },
    {
      "id": 81,
      "title": "竹里馆",
      "author": "王维",
      "dynasty": "唐",
      "grade": 6,
      "batch": "expand",
      "tags": ["竹林", "月亮"],
      "lines": ["独坐幽篁里，", "弹琴复长啸。", "深林人不知，", "明月来相照。"]
    },
    {
      "id": 82,
      "title": "峨眉山月歌",
      "author": "李白",
      "dynasty": "唐",
      "grade": 6,
      "batch": "expand",
      "tags": ["月亮", "行舟"],
      "lines": ["峨眉山月半轮秋，", "影入平羌江水流。", "夜发清溪向三峡，", "思君不见下渝州。"]
    }
  ]
}
